<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Inject physical/IIS standard handlers -->
    <handlers>
      <!-- Tells IIS to run server.js using the iisnode module -->
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Don't rewrite public static asset folders or node_modules -->
        <rule name="StaticAssets" stopProcessing="true">
          <match url="^(assets/|public/|css/|js/|images/|node_modules/)" />
          <action type="None" />
        </rule>

        <!-- Route all other requests to our Node.js app entry point (server.js) -->
        <rule name="DynamicContent">
          <conditions>
            <!-- Only rewrite if the requested path is not an actual physical file -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Configure iisnode environment and settings -->
    <iisnode 
      node_env="production"
      nodeProcessCommandLine="node"
      debuggingEnabled="false"
      loggingEnabled="true"
      devErrorsEnabled="true"
    >
      <environmentVariables>
        <!-- Securely Injecting Database Credentials -->
        <add name="DB_NAME" value="db_ac972b_attendance" />
        <add name="DB_PASSWORD" value="ghmS4fkiqd@seaU" />
        <add name="DB_SERVER" value="SQL1004.site4now.net" />
        <add name="DB_USER" value="db_ac972b_attendance_admin" />
        <add name="NODE_ENV" value="production" />
      </environmentVariables>
    </iisnode>

    <!-- Ensure IIS maps all endpoints correctly to node -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <!-- Keep sensitive segments secure but allow dynamic serving -->
          <add segment="node_modules" />
          <add segment="src" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
