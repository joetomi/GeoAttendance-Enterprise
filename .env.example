# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps Platform.
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_PLATFORM_KEY"

# DATABASE CONFIGURATION (SmarterASP.NET SQL Server)
DB_SERVER="SQL1004.site4now.net"
DB_NAME="db_ac972b_attendance"
DB_USER="db_ac972b_attendance_admin"
DB_PASSWORD="YOUR_DB_PASSWORD_HERE"
